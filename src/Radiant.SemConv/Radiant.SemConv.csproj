<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Radiant</RootNamespace>
    <AssemblyName>Radiant.SemConv</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Radiant.SemConv</PackageId>
    <Description>Radiant emit-side naming vocabulary: the Convention descriptor type and ready-made OpenTelemetry semantic-convention instrument definitions, units, and attribute keys, shared by libraries and hosts without dragging in the OpenTelemetry SDK.</Description>
    <PackageTags>telemetry;opentelemetry;semantic-conventions;metrics;naming</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="8.0.1" />
  </ItemGroup>

</Project>
