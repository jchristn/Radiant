<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Radiant</RootNamespace>
    <AssemblyName>Radiant</AssemblyName>
    <ApplicationIcon>..\..\assets\logo.ico</ApplicationIcon>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageId>Radiant</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <Description>Radiant telemetry SDK: turns RadiantSettings into a wired, exportable metrics/traces/logs pipeline (OTLP, in-process Prometheus, Loki) owned by one RadiantHost. Emit rides the .NET BCL; the app hosts. Includes the emit-side naming vocabulary — the Convention type and ready-made OpenTelemetry semantic-convention instrument definitions (SemConv).</Description>
    <PackageTags>telemetry;opentelemetry;metrics;traces;logs;otlp;prometheus;loki;observability;semantic-conventions</PackageTags>
    <!--
      NU5104: the in-process Prometheus scrape endpoint is served by
      OpenTelemetry.Exporter.Prometheus.HttpListener, which the OpenTelemetry project ships only as
      a prerelease (-beta) package. There is no stable release to depend on, so a stable Radiant
      necessarily carries a prerelease dependency. Suppressed deliberately.
    -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="OpenTelemetry" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.19.1" />
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.HttpListener" Version="1.19.1-beta.1" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" Version="1.19.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
